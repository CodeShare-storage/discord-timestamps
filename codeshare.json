    "authorSlug": "codeshare_support",
    "code": "\n<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Discord Timestamp Generator</title>\n<style>\n* { box-sizing: border-box; }\n\nbody {\n  margin: 0;\n  padding: 25px 15px;\n  background: #1e1f22;\n  color: #f2f3f5;\n  font-family: Arial, sans-serif;\n}\n\n.container {\n  max-width: 560px;\n  margin: auto;\n  background: #2b2d31;\n  padding: 25px;\n  border-radius: 15px;\n  box-shadow: 0 8px 30px #0004;\n}\n\nh1 { font-size: 25px; margin-top: 0; }\n.subtitle { color: #b5bac1; margin-bottom: 25px; }\n\nlabel {\n  display: block;\n  margin: 17px 0 7px;\n  font-weight: bold;\n  font-size: 14px;\n}\n\ninput, select {\n  width: 100%;\n  padding: 12px;\n  background: #1e1f22;\n  color: white;\n  border: 1px solid #484b52;\n  border-radius: 7px;\n  font-size: 15px;\n}\n\ninput:focus, select:focus {\n  outline: 2px solid #5865f2;\n}\n\nbutton {\n  border: none;\n  border-radius: 7px;\n  padding: 12px 17px;\n  font-size: 14px;\n  font-weight: bold;\n  cursor: pointer;\n}\n\n.primary {\n  background: #5865f2;\n  color: white;\n  width: 100%;\n  margin-top: 20px;\n}\n\n.secondary {\n  background: #404249;\n  color: white;\n}\n\nbutton:hover { filter: brightness(1.15); }\n\n.result {\n  margin-top: 22px;\n  padding: 17px;\n  background: #1e1f22;\n  border-radius: 9px;\n}\n\n.result h3 { margin-top: 0; }\n\n.output {\n  padding: 12px;\n  background: #111214;\n  color: #23d18b;\n  border-radius: 6px;\n  overflow-wrap: anywhere;\n  font-family: monospace;\n  font-size: 15px;\n}\n\n.preview {\n  margin-top: 15px;\n  padding: 13px;\n  background: #313338;\n  border-radius: 7px;\n  color: #dbdee1;\n  overflow-wrap: anywhere;\n}\n\n.hint {\n  color: #b5bac1;\n  font-size: 12px;\n  margin-top: 7px;\n}\n\n.status {\n  color: #23d18b;\n  font-size: 13px;\n  margin-top: 10px;\n  min-height: 16px;\n}\n\n.hidden { display: none; }\n\n.footer {\n  color: #949ba4;\n  font-size: 12px;\n  text-align: center;\n  margin-top: 22px;\n}\n</style>\n</head>\n\n<body>\n<div class=\"container\">\n  <h1>🕒 Discord Timestamp Generator</h1>\n  <p class=\"subtitle\">\n    Create custom Discord countdowns and date timestamps.\n  </p>\n\n  <label for=\"date\">Choose a date and time</label>\n  <input type=\"datetime-local\" id=\"date\">\n\n  <label for=\"timezone\">Time zone</label>\n  <select id=\"timezone\">\n    <option value=\"UTC\">UTC</option>\n    <option value=\"local\">My local time</option>\n  </select>\n  <p class=\"hint\">\n    UTC means the selected time is interpreted as UTC, regardless of your location.\n  </p>\n\n  <label for=\"format\">Timestamp format</label>\n  <select id=\"format\">\n    <option value=\"R\">Countdown (e.g. in 5 hours)</option>\n    <option value=\"F\">Full date and time</option>\n    <option value=\"f\">Date and time</option>\n    <option value=\"D\">Date only</option>\n    <option value=\"t\">Time only (short)</option>\n    <option value=\"T\">Time only (long)</option>\n    <option value=\"d\">Short date</option>\n  </select>\n\n  <label for=\"message\">Custom message (optional)</label>\n  <input type=\"text\" id=\"message\"\n    placeholder=\"🎄 Christmas is coming!\">\n\n  <button class=\"primary\" onclick=\"generate()\">\n    Generate timestamp\n  </button>\n\n  <div class=\"result\">\n    <h3>Generated result</h3>\n\n    <label>Discord code</label>\n    <div class=\"output\" id=\"output\">\n      Your timestamp will appear here.\n    </div>\n\n    <button class=\"secondary\" onclick=\"copyCode()\"\n      style=\"width:100%; margin-top:12px\">\n      📋 Copy timestamp\n    </button>\n\n    <label>Complete message</label>\n    <div class=\"output\" id=\"fullOutput\">\n      Your message will appear here.\n    </div>\n\n    <button class=\"secondary\" onclick=\"copyMessage()\"\n      style=\"width:100%; margin-top:12px\">\n      📋 Copy complete message\n    </button>\n\n    <div class=\"preview\">\n      <strong>Message preview</strong>\n      <p id=\"preview\">Your message will appear here.</p>\n      <p class=\"hint\">\n        Discord renders the timestamp when you send the message.\n      </p>\n    </div>\n\n    <div class=\"status\" id=\"status\"></div>\n  </div>\n\n  <div class=\"footer\">\n    Discord Timestamp Generator • Uses Unix timestamps\n  </div>\n</div>\n\n<script>\nconst dateInput = document.getElementById(\"date\");\nconst timezoneInput = document.getElementById(\"timezone\");\nconst formatInput = document.getElementById(\"format\");\nconst messageInput = document.getElementById(\"message\");\n\nlet generatedCode = \"\";\nlet generatedMessage = \"\";\n\nfunction getTimestamp() {\n  const value = dateInput.value;\n\n  if (!value) return null;\n\n  if (timezoneInput.value === \"UTC\") {\n    const [date, time] = value.split(\"T\");\n    const [year, month, day] = date.split(\"-\").map(Number);\n    const [hour, minute] = time.split(\":\").map(Number);\n\n    return Math.floor(Date.UTC(\n      year, month - 1, day, hour, minute\n    ) / 1000);\n  }\n\n  return Math.floor(new Date(value).getTime() / 1000);\n}\n\nfunction generate() {\n  const timestamp = getTimestamp();\n\n  if (timestamp === null || !Number.isFinite(timestamp)) {\n    alert(\"Please choose a valid date and time!\");\n    return;\n  }\n\n  const format = formatInput.value;\n  generatedCode = `<t:${timestamp}:${format}>`;\n\n  const message = messageInput.value.trim();\n\n  generatedMessage = message\n    ? `${message} ${generatedCode}`\n    : generatedCode;\n\n  document.getElementById(\"output\").textContent =\n    generatedCode;\n\n  document.getElementById(\"fullOutput\").textContent =\n    generatedMessage;\n\n  document.getElementById(\"preview\").textContent =\n    generatedMessage;\n\n  document.getElementById(\"status\").textContent =\n    \"✓ Timestamp generated successfully!\";\n}\n\nasync function copyText(value) {\n  if (!value) {\n    alert(\"Generate a timestamp first!\");\n    return;\n  }\n\n  try {\n    await navigator.clipboard.writeText(value);\n    document.getElementById(\"status\").textContent =\n      \"✓ Copied to clipboard!\";\n  } catch (error) {\n    document.getElementById(\"status\").textContent =\n      \"Clipboard unavailable. Select and copy the text manually.\";\n  }\n}\n\nfunction copyCode() {\n  copyText(generatedCode);\n}\n\nfunction copyMessage() {\n  copyText(generatedMessage);\n}\n\n// Default date: December 25, 2026, 11:59 PM UTC\ndateInput.value = \"2026-12-25T23:59\";\ntimezoneInput.value = \"UTC\";\n\n</script>\n</body>\n</html>",
